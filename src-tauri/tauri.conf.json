{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NotePP",
  "version": "0.1.0",
  "identifier": "com.notepp.desktop",
  "build": {
    "beforeDevCommand": "npm run build:worker && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:worker -- --release && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NotePP",
        "width": 960,
        "height": 680,
        "minWidth": 480,
        "minHeight": 320
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "externalBin": ["binaries/cleanup-worker"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
